# 이 파일은 커밋된다 (.gitignore 의 `!*.env.example`). 실제 값은 절대 여기 적지 말 것.
# 쓰는 법:  cp .env.example .env   → `.env` 에 실제 값 채우기 (`.env` 는 gitignore 됨)
#
# `docker compose` 는 프로젝트 루트 `.env` 를 자동으로 읽어 compose.yaml 의 ${VAR} 를 치환한다.
# Spring Boot 자체는 `.env` 를 읽지 않으므로, bootRun 용으로는 build.gradle.kts 가 같은 파일을
# 읽어 환경변수로 넘긴다. 키는 이 파일 하나로 관리한다.

# 식품안전나라 조리식품 레시피 DB(COOKRCP01) 인증키. 레시피 수집 배치에서만 쓴다.
# 발급: https://www.foodsafetykorea.go.kr/api/newUserApiAplcDtl.do?menu_grp=MENU_GRP32&menu_no=3995
MFDS_API_KEY=

# JWT 서명 키(HMAC-SHA256, **32바이트 이상 필수**). 기본값이 없으므로 없으면 앱이 안 뜬다.
# 운영에서는 아래 dev 값을 쓰지 말고 새로 만들 것:  openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-prod-0123456789abcdef

# 카카오 로그인용 **앱 ID**(숫자). 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 설정의 값으로,
# REST API 키가 아니다. 소비자 앱과 점주 앱은 별개의 카카오 앱이라 값이 두 개다.
# 앱이 넘긴 access token 이 정말 그 앱에서 발급된 것인지 검증하는 데만 쓴다.
# 비워 두면 앱은 뜨지만 해당 앱의 카카오 로그인이 거부된다(관리자 로그인은 영향 없음).
KAKAO_CONSUMER_APP_ID=
KAKAO_OWNER_APP_ID=

# 위 앱 ID와 짝이 되는 **REST API 키**(콘솔의 다른 값 — 헷갈리지 말 것). 웹(JS SDK) 카카오
# 로그인의 인가 코드 → access token 교환에만 쓴다(admin-web 의 /kakao-test 전용). 네이티브
# 앱은 SDK가 토큰을 직접 주므로 필요 없다. 비어 있으면 교환 요청만 거부된다.
KAKAO_CONSUMER_REST_API_KEY=
KAKAO_OWNER_REST_API_KEY=
