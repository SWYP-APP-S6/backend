# 운영 서버(`/home/deploy/backend/.env`)용 템플릿. 로컬 개발용 `.env` 와는 변수 집합이 다르다
# (로컬은 `.env.example` 참고). 이 파일은 커밋되지만 실제 값은 절대 여기 적지 않는다.
#
# 배포는 서버가 끌어온다(`ssh deploy@<서버>` → `cd ~/backend && ./scripts/deploy.sh`) — GitHub
# Actions 는 배포하지 않는다(근거는 DEPLOY.md). 실제 `.env` 는 서버 체크아웃(`~/backend/.env`)에
# 두며 gitignore 되어 있어 `git pull` 이 건드리지 않는다.

# 운영 프로파일. 이게 있어야 application-prod.properties 가 적용되어 swagger 가 닫힌다.
SPRING_PROFILES_ACTIVE=prod

# JWT 서명 키(HMAC-SHA256, 32바이트 이상). 없으면 앱이 기동하지 않는다.
#   openssl rand -base64 48
JWT_SECRET=

# PostgreSQL 비밀번호. **볼륨을 처음 초기화할 때만 적용된다** — 이미 뜬 적 있는 볼륨에 나중에
# 값을 바꾸면 인증 실패한다. 첫 배포 때 한 번 정하고 이후 바꾸지 않는다.
#   openssl rand -hex 16
POSTGRES_PASSWORD=

# 식품안전나라 레시피 DB 인증키. 레시피 수집 배치에서만 쓰므로 비어 있어도 앱은 뜬다.
MFDS_API_KEY=

# 카카오 로그인용 앱 ID(숫자, REST API 키 아님). 소비자 앱·점주 앱이 별개의 카카오 앱이라 둘이다.
# 없으면 해당 앱의 카카오 로그인이 전부 거부된다.
KAKAO_CONSUMER_APP_ID=
KAKAO_OWNER_APP_ID=

# 점주 가게 등록(주소 → 좌표 변환)용 카카오 로컬 API 키. 위 로그인용 앱 ID 와는 무관한 별개
# 값이다 — 어떤 카카오 앱이든 "카카오맵" 제품을 활성화한 **REST API 키**를 쓴다.
# 없으면 앱은 뜨지만 가게 등록이 전부 거부된다(fail-closed).
KAKAO_LOCAL_REST_API_KEY=

# 관리자 웹(admin.mangro.cloud)의 `/kakao-test` 페이지가 쓰는 인가 코드 교환용 REST API 키.
# 네이티브 앱 로그인(`/auth/{consumer,owner}/kakao`)은 SDK 가 토큰을 직접 주므로 이 값이
# 없어도 되고, 없으면 그 테스트 페이지의 웹 로그인만 거부된다(fail-closed).
KAKAO_CONSUMER_REST_API_KEY=
KAKAO_OWNER_REST_API_KEY=

# 위 REST API 키의 클라이언트 시크릿. 콘솔에서 그 키의 시크릿이 켜져 있으면 필수 —
# 빠뜨리면 카카오가 401(invalid_client, KOE010)로 교환을 거부한다. 꺼진 앱이면 비워 둔다.
KAKAO_CONSUMER_CLIENT_SECRET=
KAKAO_OWNER_CLIENT_SECRET=

# FCM 푸시(Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성).
# 프로젝트 ID 는 그 JSON 의 project_id 와 같은 값이고, 키 자체는 JSON 을 base64 한 줄로 넣는다:
#   base64 -i swyp-firebase-adminsdk-xxxxx.json | tr -d '\n'
# 비어 있으면 앱은 그대로 뜨고 푸시 발송만 꺼진다(알림은 인앱 알림함까지 간다).
FCM_PROJECT_ID=
FCM_CREDENTIALS_BASE64=

# 안드로이드 앱이 만드는 알림 채널 id. 앱에 없는 id 를 보내면 푸시가 도착해도 트레이에 뜨지
# 않으므로 앱 개발자와 값을 맞춘다. 비우면 채널 블록 없이 보낸다.
FCM_ANDROID_CHANNEL_ID=
